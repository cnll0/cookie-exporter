{
  "manifest_version": 3,
  "name": "Cookie Exporter",
  "version": "2.0.0",
  "description": "不限网站：在任意站点一键抓取 Cookie（含 httpOnly）到本地，或开启自动抓取随浏览归类保存。数据不出本机。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie 导出器"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-popup": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "打开 Cookie 面板"
    }
  },
  "permissions": ["cookies", "activeTab", "tabs", "webNavigation", "clipboardWrite", "storage"],
  "host_permissions": ["*://*/*"]
}
